{
  "public": "./root",
  "directoryListing": false,
  "headers": [
    {
      "source": "**/*.json",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    }
  ],
  "rewrites": [    
    {
      "source": "*/**/*.json",
      "destination": "/404"
    }
  ]
}